#!/usr/bin/python3 -I
import logging
import os
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk

sys.path.insert(0, os.path.join(
    os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"),
    "nemo-glass", "lib",
))
from nemo_glass import config

log = logging.getLogger("nemo-glass-prefs")

CUSTOM = "Custom"


def _hex_to_rgba(value):
    rgba = Gdk.RGBA()
    rgba.parse(value)
    return rgba


def _rgba_to_hex(rgba):
    return "#%02x%02x%02x" % tuple(round(c * 255) for c in (rgba.red, rgba.green, rgba.blue))


class Prefs(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Nemo Glass")
        self.set_default_size(520, 460)
        self.cfg = config.load()
        self._loading = True
        self._save_pending = 0
        self.widgets = {}

        stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        header = Gtk.HeaderBar(show_close_button=True)
        header.set_custom_title(Gtk.StackSwitcher(stack=stack))
        reset = Gtk.Button(label="Reset")
        reset.set_tooltip_text("Restore default settings")
        reset.connect("clicked", self._on_reset)
        header.pack_start(reset)
        self.set_titlebar(header)
        self.add(stack)

        page = self._page(stack, "window", "Window")
        self._section(page, "General", [
            ("Enabled", self._switch("enabled")),
            ("Preset", self._preset_combo()),
        ])
        self._section(page, "Background", [
            ("Opacity", self._scale("opacity", 30, 100)),
            ("Tint color", self._color("tint")),
            ("Sidebar extra shade", self._scale("sidebar_shade", 0, 50)),
            ("Inactive pane dim", self._scale("inactive_pane_dim", 0, 50)),
        ])

        page = self._page(stack, "bars", "Bars & Controls")
        self._section(page, "Title bar", [
            ("Follow window opacity", self._switch("titlebar_follow")),
            ("Title bar opacity", self._scale("titlebar_opacity", 0, 100)),
        ])
        self._section(page, "Toolbars & controls", [
            ("Transparent toolbars & status bar", self._switch("transparent_bars")),
            ("Button highlight", self._scale("controls_opacity", 0, 40)),
            ("Borders & separators", self._scale("border_opacity", 0, 40)),
            ("Scrollbars", self._scale("scrollbar_opacity", 5, 100)),
        ])

        page = self._page(stack, "selection", "Selection & Text")
        self._section(page, "Selection", [
            ("Color source", self._selection_combo()),
            ("Custom color", self._color("selection_color")),
            ("Custom opacity", self._scale("selection_opacity", 10, 100)),
        ])
        self._section(page, "Readability", [
            ("Text shadow", self._switch("text_shadow")),
        ])

        page = self._page(stack, "other", "Other")
        self._section(page, "Window shape", [
            ("Rounded bottom corners", self._switch("bottom_rounded")),
            ("Bottom corner radius (px)",
             self._scale("bottom_radius", 0, 24, percent=False)),
            ("Custom top corner radius", self._radius_switch()),
            ("Top corner radius (px)", self._scale("corner_radius", 0, 24, percent=False)),
        ])
        self._section(page, "Integration", [
            ("Show in Nemo right-click menu", self._switch("context_menu")),
        ])
        note = Gtk.Label(xalign=0, wrap=True)
        note.set_markup("<small>Changes apply live to open Nemo windows. "
                        "Settings file: %s</small>"
                        % GLib.markup_escape_text(config.CONFIG_PATH))
        note.get_style_context().add_class("dim-label")
        page.pack_end(note, False, False, 0)

        self._refresh()
        self._loading = False
        self.connect("destroy", self._flush)

    def _page(self, stack, name, title):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=18)
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroller.add(box)
        stack.add_titled(scroller, name, title)
        return box

    def _section(self, parent, title, rows):
        label = Gtk.Label(xalign=0)
        label.set_markup("<b>%s</b>" % GLib.markup_escape_text(title))
        parent.pack_start(label, False, False, 0)
        frame = Gtk.Frame()
        listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        frame.add(listbox)
        parent.pack_start(frame, False, False, 0)
        for text, widget in rows:
            row = Gtk.Box(spacing=12, margin=8)
            row.pack_start(Gtk.Label(label=text, xalign=0), True, True, 0)
            row.pack_end(widget, False, False, 0)
            listbox.add(row)
            widget.row = row

    def _switch(self, key):
        w = Gtk.Switch(valign=Gtk.Align.CENTER)
        w.connect("notify::active", lambda s, _p: self._set(key, s.get_active()))
        self.widgets[key] = w
        return w

    def _scale(self, key, low, high, percent=True):
        w = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, low, high, 1)
        w.set_size_request(200, -1)
        w.set_value_pos(Gtk.PositionType.RIGHT)
        w.set_digits(0)
        if percent:
            w.connect("format-value", lambda _s, v: "%d%%" % v)
            w.connect("value-changed", lambda s: self._set(key, round(s.get_value()) / 100))
        else:
            w.connect("value-changed", lambda s: self._set(key, int(s.get_value())))
        w.percent = percent
        self.widgets[key] = w
        return w

    def _color(self, key):
        w = Gtk.ColorButton(use_alpha=False)
        w.connect("color-set", lambda b: self._set(key, _rgba_to_hex(b.get_rgba())))
        self.widgets[key] = w
        return w

    def _preset_combo(self):
        w = Gtk.ComboBoxText()
        for name in [CUSTOM, *config.PRESETS]:
            w.append(name, name)
        w.connect("changed", self._on_preset)
        self.preset_combo = w
        return w

    def _selection_combo(self):
        w = Gtk.ComboBoxText()
        w.append("theme", "Theme accent")
        w.append("custom", "Custom color")
        w.connect("changed", lambda c: self._set("selection_mode", c.get_active_id()))
        self.widgets["selection_mode"] = w
        return w

    def _radius_switch(self):
        w = Gtk.Switch(valign=Gtk.Align.CENTER)
        w.connect("notify::active", self._on_radius_toggle)
        self.radius_switch = w
        return w

    def _on_radius_toggle(self, switch, _pspec):
        if self._loading:
            return
        self._set("corner_radius", 8 if switch.get_active() else -1)
        self._refresh()

    def _on_preset(self, combo):
        if self._loading:
            return
        name = combo.get_active_id()
        if name in config.PRESETS:
            self.cfg.update(config.PRESETS[name])
            self._refresh()
            self._schedule_save()

    def _on_reset(self, _button):
        self.cfg = dict(config.DEFAULTS)
        self._refresh()
        self._schedule_save()

    def _set(self, key, value):
        if self._loading:
            return
        self.cfg[key] = value
        self._loading = True
        self._update_preset()
        self._update_sensitivity()
        self._loading = False
        self._schedule_save()

    def _refresh(self):
        was_loading, self._loading = self._loading, True
        for key, w in self.widgets.items():
            value = self.cfg[key]
            if isinstance(w, Gtk.Switch):
                w.set_active(value)
            elif isinstance(w, Gtk.Scale):
                if key == "corner_radius":
                    w.set_value(max(value, 0))
                else:
                    w.set_value(value * 100 if w.percent else value)
            elif isinstance(w, Gtk.ColorButton):
                w.set_rgba(_hex_to_rgba(value))
            elif isinstance(w, Gtk.ComboBoxText):
                w.set_active_id(value)
        self.radius_switch.set_active(self.cfg["corner_radius"] >= 0)
        self._update_preset()
        self._update_sensitivity()
        self._loading = was_loading

    def _update_preset(self):
        current = CUSTOM
        for name, values in config.PRESETS.items():
            merged = config.normalize(dict(config.DEFAULTS, **values))
            if all(self.cfg[k] == merged[k] for k in merged if k != "context_menu"
                   and k != "enabled"):
                current = name
                break
        self.preset_combo.set_active_id(current)

    def _update_sensitivity(self):
        on = self.cfg["enabled"]
        for key, w in self.widgets.items():
            if key != "enabled":
                w.row.set_sensitive(on)
        self.preset_combo.row.set_sensitive(on)
        self.radius_switch.row.set_sensitive(on)
        self.widgets["titlebar_opacity"].row.set_sensitive(
            on and not self.cfg["titlebar_follow"])
        custom_sel = on and self.cfg["selection_mode"] == "custom"
        self.widgets["selection_color"].row.set_sensitive(custom_sel)
        self.widgets["selection_opacity"].row.set_sensitive(custom_sel)
        self.widgets["corner_radius"].row.set_sensitive(
            on and self.cfg["corner_radius"] >= 0)
        self.widgets["bottom_radius"].row.set_sensitive(
            on and self.cfg["bottom_rounded"])

    def _schedule_save(self):
        if self._save_pending:
            GLib.source_remove(self._save_pending)
        self._save_pending = GLib.timeout_add(150, self._save)

    def _save(self):
        self._save_pending = 0
        try:
            config.save(self.cfg)
        except OSError as exc:
            log.error("cannot save %s: %s", config.CONFIG_PATH, exc)
            dialog = Gtk.MessageDialog(
                transient_for=self, modal=True,
                message_type=Gtk.MessageType.ERROR,
                buttons=Gtk.ButtonsType.CLOSE,
                text="Cannot save settings",
                secondary_text=str(exc),
            )
            dialog.run()
            dialog.destroy()
        return GLib.SOURCE_REMOVE

    def _flush(self, _window):
        if self._save_pending:
            GLib.source_remove(self._save_pending)
            self._save()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.nemo_glass.Prefs")

    def do_activate(self):
        win = self.get_active_window() or Prefs(self)
        win.show_all()
        win.present()


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, format="%(name)s: %(levelname)s: %(message)s")
    sys.exit(App().run(sys.argv))
